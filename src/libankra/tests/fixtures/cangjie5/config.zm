{
    specs: {
        9 : [ ESCAPE           ],
        22: [ BACKSPACE        ],
        23: [ NEXT, PREV       ],
        36: [ RAWCOMMIT        ],
        65: [ COMMIT           ],
        113:[ PREV             ],
        114:[ NEXT             ],
        10 :[ 1, COMMITANDPASS ], # Exclamation Point (!)
        11 :[ 2, COMMITANDPASS ], # Quotation Mark (")
        12 :[ 3, COMMITANDPASS ], # Hashtag (#)
        13 :[ 4, COMMITANDPASS ], # Dollar ($)
        14 :[ 5, COMMITANDPASS ], # Percentage (%)
        15 :[ 6, COMMITANDPASS ], # Caret (^)
        16 :[ 7, COMMITANDPASS ], # Ampersand (&)
        17 :[ 8, COMMITANDPASS ], # Asterisk (*)
        18 :[ 9, COMMITANDPASS ], # Paranthesis Left (()
        19 :[ 0, COMMITANDPASS ], # Paranthesis Right ())
        20: [ COMMITANDPASS, COMMITANDPASS ], # Minus / Underscore (or map to PREV)
        21: [ COMMITANDPASS, COMMITANDPASS ], # Equal / Plus (or map to NEXT)
        49: [ COMMITANDPASS, COMMITANDPASS ], # Backtick / Tilde
        51: [ COMMITANDPASS, COMMITANDPASS ], # Backslash / Pipe
        59: [ COMMITANDPASS, COMMITANDPASS ], # Comma (,) / Less Than (<)
        60: [ COMMITANDPASS, COMMITANDPASS ], # Period (.) / Greater Than (>)
        61: [ COMMITANDPASS, COMMITANDPASS, COMMITANDPASS ], # Slash (/) / Question Mark (?)
        47: [ COMMITANDPASS, COMMITANDPASS ], # Semicolon (;) / Colon (:)
        48: [ COMMITANDPASS, COMMITANDPASS ], # Quote (') / Double Quote (")
        34: [ COMMITANDPASS, COMMITANDPASS ], # Left Bracket ([) / Brace ({)
        35: [ COMMITANDPASS, COMMITANDPASS ]  # Right Bracket (]) / Brace (})
    },

    keys: {
        24: [ q ],
        25: [ w ],
        26: [ e ],
        27: [ r ],
        28: [ t ],
        29: [ y ],
        30: [ u ],
        31: [ i ],
        32: [ o ],
        33: [ p ],
        38: [ a ],
        39: [ s ],
        40: [ d ],
        41: [ f ],
        42: [ g ],
        43: [ h ],
        44: [ j ],
        45: [ k ],
        46: [ l ],
        52: [ z ],
        53: [ x ],
        54: [ c ],
        55: [ v ],
        56: [ b ],
        57: [ n ],
        58: [ m ]
    }
}
